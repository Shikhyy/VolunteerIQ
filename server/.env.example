PORT=5000

# Supabase Configuration (get from https://supabase.com)
# Replace these with your own values from Supabase dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Google AI (get from https://aistudio.google.com/app)
GEMINI_API_KEY=your-gemini-api-key

# Cross-Origin Resource Sharing
# Use * for development, specific domain for production
CORS_ORIGIN=*

# Development mode
DEV_MODE=false

# Groq AI (optional, for additional features)
GROQ_API_KEY=your-groq-api-key